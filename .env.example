# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Public URL of the app, without a trailing slash (e.g. https://fansessions.vercel.app)
APP_URL=

# Fanvue developer app (fanvue.com/dev → your app → Authentication tab)
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# App UUID (from the app's URL in fanvue.com/dev/apps/<uuid>) and webhook signing secret (Events tab → View signing secret)
FANVUE_APP_UUID=
FANVUE_WEBHOOK_SECRET=

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily (dashboard.daily.co → Developers → API key)
DAILY_API_KEY=
DAILY_DOMAIN=fansessions.daily.co

# Two long random strings (at least 32 characters each).
# SESSION_SECRET signs login cookies; TOKEN_ENCRYPTION_KEY encrypts stored Fanvue tokens.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
